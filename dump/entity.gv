// Entity Graph
digraph {
	node [shape=plaintext]
	1 [label=<<table border='0' cellborder='1' cellspacing='0'><tr><td colspan='2'><b>Diagnosis</b></td></tr><tr><td>Condition</td><td>AML or ALAL</td></tr></table>>]
	2 [label=<<table border='0' cellborder='1' cellspacing='0'><tr><td colspan='2'><b>Requirement</b></td></tr><tr><td>Treatment Description</td><td>at least two courses of induction chemotherapy</td></tr><tr><td>Condition Description</td><td>persistent leukemia</td></tr></table>>]
	3 [label=<<table border='0' cellborder='1' cellspacing='0'><tr><td colspan='2'><b>Requirement</b></td></tr><tr><td>Condition</td><td>Early relapsed leukemia</td></tr><tr><td>Condition Description</td><td>re-appearance of leukemia after the achievement of remission and within one year of diagnosis</td></tr></table>>]
	4 [label=<<table border='0' cellborder='1' cellspacing='0'><tr><td colspan='2'><b>Requirement</b></td></tr><tr><td>Condition</td><td>Relapsed leukemia</td></tr><tr><td>Condition Description</td><td>refractory to at least one course of salvage therapy</td></tr></table>>]
	5 [label=<<table border='0' cellborder='1' cellspacing='0'><tr><td colspan='2'><b>Requirement</b></td></tr><tr><td>Condition</td><td>Relapsed leukemia</td></tr><tr><td>Condition Description</td><td>Relapsed leukemia following HCT</td></tr></table>>]
	6 [label=<<table border='0' cellborder='1' cellspacing='0'><tr><td colspan='2'><b>Requirement</b></td></tr><tr><td>Condition</td><td>Second or greater relapse</td></tr></table>>]
	7 [label=<<table border='0' cellborder='1' cellspacing='0'><tr><td colspan='2'><b>Requirement</b></td></tr><tr><td>Condition</td><td>late first relapses</td></tr><tr><td>Condition Description</td><td>re-appearance of leukemia after the achievement of remission and greater than one year of diagnosis</td></tr></table>>]
	8 [label=<<table border='0' cellborder='1' cellspacing='0'><tr><td colspan='2'><b>Requirement</b></td></tr><tr><td>Condition</td><td>blasts in the bone marrow</td></tr><tr><td>Percentage</td><td>≥ 5%</td></tr></table>>]
	9 [label=<<table border='0' cellborder='1' cellspacing='0'><tr><td colspan='2'><b>Requirement</b></td></tr><tr><td>Condition</td><td>leukemia</td></tr><tr><td>Percentage</td><td>≥ 5%</td></tr></table>>]
	10 [label=<<table border='0' cellborder='1' cellspacing='0'><tr><td colspan='2'><b>Organ Function Requirement</b></td></tr><tr><td>Condition</td><td>Direct bilirubin</td></tr><tr><td>Threshold</td><td>≤ 1.5 x institutional upper limit of normal (ULN)</td></tr></table>>]
	11 [label=<<table border='0' cellborder='1' cellspacing='0'><tr><td colspan='2'><b>Organ Function Requirement</b></td></tr><tr><td>Condition</td><td>Creatinine</td></tr><tr><td>Threshold</td><td>Normal creatinine for age or a calculated creatinine clearance ≥ 30 mL/min/1.73m^2</td></tr></table>>]
	12 [label=<<table border='0' cellborder='1' cellspacing='0'><tr><td colspan='2'><b>Organ Function Requirement</b></td></tr><tr><td>Condition</td><td>Left ventricular ejection fraction or shortening fraction</td></tr><tr><td>Threshold</td><td>≥ 40% or shortening fraction ≥ 25%</td></tr></table>>]
	13 [label=<<table border='0' cellborder='1' cellspacing='0'><tr><td colspan='2'><b>Age Requirement</b></td></tr><tr><td>Age</td><td>≥ 2 years of age and ≤ 30 years old</td></tr></table>>]
	14 [label=<<table border='0' cellborder='1' cellspacing='0'><tr><td colspan='2'><b>Age Requirement</b></td></tr><tr><td>Age</td><td>upper age limit may be defined by each institution, but may not exceed 30 years. Patients treated at St. Jude Children's Research Hospital must be ≤ 24 years old</td></tr></table>>]
	15 [label=<<table border='0' cellborder='1' cellspacing='0'><tr><td colspan='2'><b>Performance Status</b></td></tr><tr><td>Condition</td><td>Lansky or Karnofsky score</td></tr><tr><td>Threshold</td><td>Lansky ≥ 50 for patients who are ≤ 16 years old and Karnofsky ≥ 50% for patients who are > 16 years old</td></tr></table>>]
	16 [label=<<table border='0' cellborder='1' cellspacing='0'><tr><td colspan='2'><b>Timing Requirement</b></td></tr><tr><td>Condition</td><td>completion of myelosuppressive therapy or hypomethylating agents</td></tr><tr><td>Elapsed Time</td><td>14 days</td></tr></table>>]
	17 [label=<<table border='0' cellborder='1' cellspacing='0'><tr><td colspan='2'><b>Timing Requirement</b></td></tr><tr><td>Condition</td><td>completion of low-dose or non-myelosuppressive therapy</td></tr><tr><td>Elapsed Time</td><td>24 hours</td></tr></table>>]
	18 [label=<<table border='0' cellborder='1' cellspacing='0'><tr><td colspan='2'><b>Treatment</b></td></tr><tr><td>Condition</td><td>low-dose cytarabine</td></tr><tr><td>Dosage</td><td>up to 100 mg/m^2/day</td></tr></table>>]
	19 [label=<<table border='0' cellborder='1' cellspacing='0'><tr><td colspan='2'><b>Post-Treatment Condition</b></td></tr><tr><td>Condition</td><td>received prior HCT, no evidence of GVHD</td></tr><tr><td>Elapsed Time</td><td>60 days</td></tr></table>>]
	20 [label=<<table border='0' cellborder='1' cellspacing='0'><tr><td colspan='2'><b>Timing Requirement</b></td></tr><tr><td>Condition</td><td>completion of any calcineurin inhibitors</td></tr><tr><td>Elapsed Time</td><td>14 days</td></tr></table>>]
	21 [label=<<table border='0' cellborder='1' cellspacing='0'><tr><td colspan='2'><b>Drug Interaction Requirement</b></td></tr><tr><td>Condition</td><td>CYP3A inducers</td></tr><tr><td>Restricted Drug Interaction</td><td>rifampin</td></tr><tr><td>Time Restriction</td><td>within 3 days of the first dose of venetoclax</td></tr></table>>]
	22 [label=<<table border='0' cellborder='1' cellspacing='0'><tr><td colspan='2'><b>Drug Interaction Requirement</b></td></tr><tr><td>Condition</td><td>strong CYP3A inhibitors</td></tr><tr><td>Restricted Drug Interaction</td><td>ketoconazole, itraconazole, voriconazole, posaconazole</td></tr><tr><td>Time Restriction</td><td>within 3 days of the first dose of venetoclax</td></tr></table>>]
	23 [label=<<table border='0' cellborder='1' cellspacing='0'><tr><td colspan='2'><b>Drug Dosage Adjustment</b></td></tr><tr><td>Drug</td><td>venetoclax</td></tr><tr><td>Adjusted Dosage</td><td>60 mg/m^2 (100 mg max) in patients who require treatment with voriconazole</td></tr></table>>]
	24 [label=<<table border='0' cellborder='1' cellspacing='0'><tr><td colspan='2'><b>Drug Dosage Adjustment</b></td></tr><tr><td>Drug</td><td>venetoclax</td></tr><tr><td>Adjusted Dosage</td><td>40 mg/m^2 (70 mg max) in patients who require treatment with posaconazole</td></tr></table>>]
	25 [label=<<table border='0' cellborder='1' cellspacing='0'><tr><td colspan='2'><b>Reproductive Status</b></td></tr><tr><td>Condition</td><td>pregnant or breastfeeding</td></tr><tr><td>Requirement</td><td>Male or female of reproductive potential must agree to use effective contraception</td></tr></table>>]
	26 [label=<<table border='0' cellborder='1' cellspacing='0'><tr><td colspan='2'><b>Non-Eligible Conditions</b></td></tr><tr><td>Condition</td><td>Down syndrome, acute promyelocytic leukemia, juvenile myelomonocytic leukemia, or bone marrow failure syndromes</td></tr></table>>]
	27 [label=<<table border='0' cellborder='1' cellspacing='0'><tr><td colspan='2'><b>Infection Control Requirement</b></td></tr><tr><td>Condition</td><td>uncontrolled infection</td></tr><tr><td>Exception</td><td>Patients with infections that are controlled on concurrent anti-microbial agents are eligible</td></tr></table>>]
	28 [label=<<table border='0' cellborder='1' cellspacing='0'><tr><td colspan='2'><b>GI Function Requirement</b></td></tr><tr><td>Condition</td><td>Impairment of GI function or GI disease</td></tr><tr><td>Effect</td><td>may significantly alter the absorption of venetoclax or selinexor</td></tr></table>>]
	29 [label=<<table border='0' cellborder='1' cellspacing='0'><tr><td colspan='2'><b>Neurological Requirement</b></td></tr><tr><td>Condition</td><td>History of cerebellar toxicity or cerebellar neurological findings on exam</td></tr></table>>]
	30 [label=<<table border='0' cellborder='1' cellspacing='0'><tr><td colspan='2'><b>Hypersensitivity Requirement</b></td></tr><tr><td>Condition</td><td>hypersensitivity</td></tr><tr><td>Drug</td><td>venetoclax</td></tr></table>>]
	31 [label=<<table border='0' cellborder='1' cellspacing='0'><tr><td colspan='2'><b>Bone Marrow Condition</b></td></tr><tr><td>Condition</td><td>blasts in the bone marrow</td></tr><tr><td>Threshold</td><td>≥ 5%</td></tr></table>>]
	32 [label=<<table border='0' cellborder='1' cellspacing='0'><tr><td colspan='2'><b>Bone Marrow Condition Exception</b></td></tr><tr><td>Exception</td><td>if flow cytometry cannot be performed or if an adequate bone marrow sample cannot be obtained</td></tr><tr><td>Alternative Condition</td><td>unequivocal evidence of leukemia with ≥ 5% blasts in the blood</td></tr></table>>]
}
